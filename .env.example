# Copy this file to .env.local and fill in the values from Supabase:
#   Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / "publishable" key. Safe for the browser because Row Level Security protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Your site URL (used in password-reset emails). Use http://localhost:3000 locally and your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Currency shown on the site (ISO code), e.g. USD, EUR, GBP, INR
NEXT_PUBLIC_CURRENCY=USD
# NOTE: this project never needs the Supabase service_role key. Do NOT add it.
